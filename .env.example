# Copy to .env.local and fill in what you have. Empty values are hidden on the site.
# Every VITE_ variable is bundled into public JavaScript: never put secrets here.

# Production origin, no trailing slash (e.g. https://www.example.dev).
# Enables canonical URLs, absolute social-preview URLs, sitemap.xml and the robots.txt sitemap line.
VITE_SITE_URL=

# Identity and links
VITE_OWNER_NAME=
VITE_LOCATION=
VITE_CONTACT_EMAIL=
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=
VITE_X_URL=
# Path in /public (e.g. /resume/cv.pdf) or an https URL
VITE_RESUME_URL=

# Contact form endpoint. Use /api/contact for the bundled Vercel function,
# or any HTTPS endpoint that accepts the JSON described in the README.
# Leave empty to show an email fallback instead of a form submission.
VITE_CONTACT_ENDPOINT=

# --- Server-only variables for api/contact.js (set in your host's dashboard, not here) ---
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
# CONTACT_ALLOWED_ORIGIN=
